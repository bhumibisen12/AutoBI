# AutoBI configuration template
# Copy this file to .env and fill in real values locally.
# NEVER commit .env or put real API keys in version control.

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Upload and retention guardrails
MAX_UPLOAD_MB=50
MAX_ROWS=500000
RETENTION_HOURS=24

# Optional deep-learning module (OFF by default)
ENABLE_DL=false

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

